<UserControl x:Class="Dockyra.Presentation.Wpf.Views.FolderFlyoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Dockyra.Presentation.Wpf.Converters">
  <UserControl.Resources>
    <conv:Bgra32ToImageSourceConverter x:Key="IconConverter" />
    <conv:BytesPresenceToVisibilityConverter x:Key="BytesVisConverter" />
    <conv:HexToBrushConverter x:Key="HexBrush" />
  </UserControl.Resources>

  <Border Background="{DynamicResource Theme.Brush.Surface}"
          BorderBrush="{Binding GroupColorHex, Converter={StaticResource HexBrush}}"
          BorderThickness="2"
          CornerRadius="18"
          Padding="14"
          Margin="0,0,0,8"
          Width="360">
    <StackPanel>
      <!-- Android Folder Header (Editable Title + Delete Folder + Close) -->
      <Border Background="{Binding GroupColorHex, Converter={StaticResource HexBrush}, ConverterParameter=45}"
              BorderBrush="{Binding GroupColorHex, Converter={StaticResource HexBrush}}"
              BorderThickness="1"
              CornerRadius="12"
              Padding="10,6"
              Margin="0,0,0,10">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Content="🗑️"
                    Command="{Binding DeleteCurrentFolderCommand}"
                    Padding="6,2"
                    Margin="0,0,4,0"
                    FontSize="11.5"
                    ToolTip="Bu klasörü dağıt / kaldır" />
            <Button Content="✕"
                    Click="OnClosePopupButtonClick"
                    Padding="7,2"
                    FontWeight="Bold" />
          </StackPanel>

          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="📦 " FontSize="15" VerticalAlignment="Center" />
            <TextBox Text="{Binding GroupTitle, UpdateSourceTrigger=PropertyChanged}"
                     Background="Transparent"
                     BorderThickness="0"
                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                     FontSize="14.5"
                     FontWeight="Bold"
                     MinWidth="140"
                     MaxWidth="200"
                     VerticalAlignment="Center"
                     ToolTip="Klasör adını değiştirmek için tıklayın" />
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- App Icons Grid Inside Folder (Android-style 3-column mini box) -->
      <ScrollViewer MaxHeight="290"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding FilteredApplications}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Width="98" Height="88" Margin="4">
                <Button Command="{Binding DataContext.LaunchApplicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Padding="6,6"
                        ToolTip="{Binding DisplayName}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,5">
                      <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                             Width="32"
                             Height="32"
                             RenderOptions.BitmapScalingMode="HighQuality"
                             Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}}" />
                      <TextBlock Text="🚀"
                                 FontSize="18"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}, ConverterParameter=Invert}" />
                    </Grid>
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="84" />
                  </StackPanel>
                </Button>

                <!-- Tiny Remove (x) badge in top-right corner of each app in the folder -->
                <Button Content="✕"
                        Command="{Binding DataContext.RemoveApplicationFromFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                        CommandParameter="{Binding}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,2,2,0"
                        Padding="4,0"
                        FontSize="9"
                        Background="#66000000"
                        BorderThickness="0"
                        ToolTip="Kutudan çıkar" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="💡 İpucu: Başka bir ikonu bu kutunun üstüne sürükleyip bırakarak ekleyebilirsiniz."
                 Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                 FontSize="10.5"
                 TextWrapping="Wrap"
                 Margin="4,8,4,0" />
    </StackPanel>
  </Border>
</UserControl>
