<UserControl x:Class="Dockyra.Presentation.Wpf.Views.FolderFlyoutControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Dockyra.Presentation.Wpf.Converters">
  <UserControl.Resources>
    <conv:Bgra32ToImageSourceConverter x:Key="IconConverter" />
    <conv:BytesPresenceToVisibilityConverter x:Key="BytesVisConverter" />
    <conv:HexToBrushConverter x:Key="HexBrush" />
  </UserControl.Resources>

  <Border Background="{DynamicResource Theme.Brush.Surface}"
          BorderBrush="{Binding GroupColorHex, Converter={StaticResource HexBrush}}"
          BorderThickness="2"
          CornerRadius="14"
          Padding="14"
          Margin="0,0,0,8"
          Width="430">
    <StackPanel>
      <!-- Colorful Folder Header Banner -->
      <Border Background="{Binding GroupColorHex, Converter={StaticResource HexBrush}, ConverterParameter=55}"
              BorderBrush="{Binding GroupColorHex, Converter={StaticResource HexBrush}}"
              BorderThickness="1"
              CornerRadius="10"
              Padding="12,8"
              Margin="0,0,0,10">
        <DockPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="📂 " FontSize="17" VerticalAlignment="Center" />
            <TextBlock Text="{Binding GroupTitle}"
                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
            <TextBlock Text="{Binding FilteredApplications.Count, StringFormat='  ({0} uygulama)'}"
                       Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                       FontSize="12"
                       VerticalAlignment="Center" />
          </StackPanel>

          <Button Content="✕"
                  Click="OnClosePopupButtonClick"
                  HorizontalAlignment="Right"
                  Padding="7,2"
                  FontWeight="Bold" />
        </DockPanel>
      </Border>

      <!-- Instant Filter Search Box -->
      <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
               Margin="0,0,0,10"
               Padding="9,6"
               AutomationProperties.Name="{DynamicResource Loc.Folder.SearchPlaceholder}" />

      <!-- Colorful App Cards Grid with Real Windows 11 Icons -->
      <ScrollViewer MaxHeight="320"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding FilteredApplications}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Command="{Binding DataContext.LaunchApplicationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                      CommandParameter="{Binding}"
                      Width="124"
                      Height="84"
                      Margin="4"
                      Padding="8,6"
                      ToolTip="{Binding DisplayName}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Grid Width="32" Height="32" HorizontalAlignment="Center" Margin="0,0,0,6">
                    <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                           Width="32"
                           Height="32"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}}" />
                    <TextBlock Text="🚀"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}, ConverterParameter=Invert}" />
                  </Grid>
                  <TextBlock Text="{Binding DisplayName}"
                             FontSize="11.5"
                             FontWeight="SemiBold"
                             TextAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             MaxWidth="106" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                 FontSize="11.5"
                 Margin="4,6,0,0" />
    </StackPanel>
  </Border>
</UserControl>
