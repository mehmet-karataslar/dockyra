<Window x:Class="Dockyra.Presentation.Wpf.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dockyra.Presentation.Wpf.Views"
        xmlns:conv="clr-namespace:Dockyra.Presentation.Wpf.Converters"
        Title="{DynamicResource Loc.App.Title}"
        Height="54"
        Width="1280"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:Bgra32ToImageSourceConverter x:Key="IconConverter" />
    <conv:BytesPresenceToVisibilityConverter x:Key="BytesVisConverter" />
    <conv:HexToBrushConverter x:Key="HexBrush" />
  </Window.Resources>

  <Grid Opacity="{Binding BarOpacity}">
    <!-- Upward Folder Flyout Box (Opens directly above whichever Group Button was clicked) -->
    <Popup x:Name="GroupFlyoutPopup"
           IsOpen="{Binding FolderPopup.IsOpen, Mode=TwoWay}"
           Placement="Top"
           PlacementTarget="{Binding ElementName=MainTaskbarBorder}"
           VerticalOffset="-6"
           StaysOpen="False"
           AllowsTransparency="True">
      <views:FolderFlyoutControl DataContext="{Binding FolderPopup}" />
    </Popup>

    <!-- Full Taskbar Background Container -->
    <Border x:Name="MainTaskbarBorder"
            Background="{DynamicResource Theme.Brush.Surface}"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8,4"
            Margin="2"
            MouseLeftButtonDown="OnTaskbarBorderMouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ISLAND 1: Start Menu & Studio Island -->
        <Border Grid.Column="0"
                Background="#28000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="{Binding GroupPillCornerRadius}"
                Padding="6,3"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding OpenStartMenuCommand}"
                    Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,4,0"
                    Padding="9,4"
                    ToolTip="Windows 11 Başlat Menüsünü Aç">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⊞ " Foreground="{DynamicResource Token.Brush.Accent}" FontWeight="Bold" FontSize="13" />
                <TextBlock Text="{DynamicResource Loc.Taskbar.Start}" FontWeight="Bold" FontSize="12" />
              </StackPanel>
            </Button>

            <Button Click="OnOpenSettingsClick"
                    Background="{DynamicResource Token.Brush.Accent}"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="9,4"
                    FontSize="12"
                    ToolTip="{DynamicResource Loc.Settings.Title}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎨 " FontSize="12" />
                <TextBlock Text="{DynamicResource Loc.Taskbar.Studio}" FontWeight="Bold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- ISLAND 2: Segmented Group / Folder Boxes (Click to Pop Upward, Drag Apps Here!) -->
        <Border Grid.Column="1"
                Background="#28000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="{Binding GroupPillCornerRadius}"
                Padding="6,3"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border CornerRadius="{Binding DataContext.GroupPillCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                        Background="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=42}"
                        BorderBrush="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=110}"
                        BorderThickness="1"
                        Margin="0,0,5,0">
                  <Button Click="OnGroupPillButtonClick"
                          Tag="{Binding}"
                          AllowDrop="True"
                          PreviewMouseLeftButtonDown="OnGroupPillPreviewMouseLeftButtonDown"
                          PreviewMouseMove="OnGroupPillPreviewMouseMove"
                          DragOver="OnGroupPillDragOver"
                          Drop="OnGroupPillDrop"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10,4"
                          ToolTip="Tıklayın: Kutu yukarı açılsın | Uygulama sürükleyip buraya bırakın!">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="8"
                              Height="8"
                              CornerRadius="4"
                              Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}"
                                 Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                 FontWeight="Bold"
                                 FontSize="12"
                                 VerticalAlignment="Center" />
                      <Border Background="#40000000"
                              CornerRadius="5"
                              Padding="5,1"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Applications.Count}"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   FontSize="10.5"
                                   FontWeight="Bold" />
                      </Border>
                      <TextBlock Text=" ▲"
                                 Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                 FontSize="9"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>

        <!-- ISLAND 3: Real Pinned Taskbar Icons + Active Open Window Icons (Live Size & Shape!) -->
        <Border Grid.Column="2"
                Background="#28000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="{Binding GroupPillCornerRadius}"
                Padding="8,2"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Visibility="{Binding ShowOpenWindows, Converter={StaticResource BoolToVis}}">
          <ScrollViewer x:Name="WindowsScrollViewer"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="OnWindowsScrollViewerPreviewMouseWheel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <!-- Real Pinned Taskbar App Icons (Live Shaped & Sized) -->
              <ItemsControl ItemsSource="{Binding PinnedApps}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="{Binding DataContext.IconShapeCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#24FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Margin="2,0">
                      <Button Command="{Binding DataContext.LaunchPinnedAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              PreviewMouseLeftButtonDown="OnPinnedAppPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnPinnedAppPreviewMouseMove"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="6,4"
                              ToolTip="{Binding DisplayName}">
                        <Grid Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                              Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}">
                          <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                                 Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                 Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                 RenderOptions.BitmapScalingMode="HighQuality"
                                 Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}}" />
                          <TextBlock Text="📌"
                                     FontSize="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}, ConverterParameter=Invert}" />
                        </Grid>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- Visual Divider between Pinned Icons and Open Windows -->
              <Border Width="1.5"
                      Height="22"
                      Background="{DynamicResource Token.Brush.Accent}"
                      Opacity="0.5"
                      Margin="8,0"
                      VerticalAlignment="Center" />

              <!-- Open Running Windows with Real Icons (Live Shaped & Sized) -->
              <ItemsControl ItemsSource="{Binding OpenWindows}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="{Binding DataContext.IconShapeCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="#24FFFFFF"
                            BorderBrush="#30FFFFFF"
                            BorderThickness="1"
                            Margin="2,0">
                      <Button Command="{Binding DataContext.ActivateOrToggleWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              PreviewMouseLeftButtonDown="OnOpenWindowPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnOpenWindowPreviewMouseMove"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="8,4"
                              MaxWidth="190"
                              ToolTip="{Binding Title}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <Grid Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center">
                            <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                                   Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}}" />
                            <TextBlock Text="🪟"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}, ConverterParameter=Invert}" />
                          </Grid>
                          <TextBlock Text="{Binding Title}"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                     FontWeight="SemiBold"
                                     FontSize="11.5"
                                     TextTrimming="CharacterEllipsis"
                                     MaxWidth="120"
                                     VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- ISLAND 4: System Status Tray (Wi-Fi, Bluetooth, Battery First + Clock + Swap) -->
        <Border Grid.Column="3"
                Background="#28000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="{Binding GroupPillCornerRadius}"
                Padding="6,3"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ShowPowerBadge, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center">
              <!-- 1. Wi-Fi Indicator -->
              <Button Content="{Binding WifiStatusText}"
                      Command="{Binding OpenWifiSettingsCommand}"
                      Background="#22FFFFFF"
                      BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      Margin="0,0,4,0"
                      Padding="7,4"
                      FontSize="11.5"
                      FontWeight="SemiBold"
                      ToolTip="Wi-Fi &amp; Network" />

              <!-- 2. Bluetooth Indicator -->
              <Button Content="{Binding BluetoothStatusText}"
                      Command="{Binding OpenBluetoothSettingsCommand}"
                      Background="#22FFFFFF"
                      BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      Margin="0,0,4,0"
                      Padding="7,4"
                      FontSize="11.5"
                      FontWeight="SemiBold"
                      ToolTip="Bluetooth" />

              <!-- 3. Battery (Pil) Indicator -->
              <Button Content="{Binding BatteryStatusText}"
                      Command="{Binding CyclePowerModeCommand}"
                      Background="#22FFFFFF"
                      BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      Margin="0,0,6,0"
                      Padding="8,4"
                      FontSize="11.5"
                      FontWeight="Bold"
                      ToolTip="Battery / Power Mode" />
            </StackPanel>

            <!-- 4. Live Clock & Date -->
            <StackPanel Visibility="{Binding ShowClock, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center"
                        Margin="2,0,8,0">
              <TextBlock Text="{Binding CurrentTimeText}"
                         Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                         FontSize="11.5"
                         FontWeight="Bold"
                         HorizontalAlignment="Right" />
              <TextBlock Text="{Binding CurrentDateText}"
                         Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                         FontSize="9.5"
                         HorizontalAlignment="Right" />
            </StackPanel>

            <!-- 5. 1-Click Return to Microsoft Taskbar -->
            <Button Content="{DynamicResource Loc.Taskbar.ReturnMicrosoft}"
                    Command="{Binding SwitchBackToMicrosoftTaskbarCommand}"
                    Padding="8,4"
                    FontSize="11"
                    FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
