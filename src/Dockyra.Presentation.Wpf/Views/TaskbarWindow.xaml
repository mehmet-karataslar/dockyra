<Window x:Class="Dockyra.Presentation.Wpf.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dockyra.Presentation.Wpf.Views"
        xmlns:conv="clr-namespace:Dockyra.Presentation.Wpf.Converters"
        Title="{DynamicResource Loc.App.Title}"
        Height="54"
        Width="1280"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <conv:Bgra32ToImageSourceConverter x:Key="IconConverter" />
    <conv:BytesPresenceToVisibilityConverter x:Key="BytesVisConverter" />
    <conv:HexToBrushConverter x:Key="HexBrush" />
  </Window.Resources>

  <Grid Opacity="{Binding BarOpacity}">
    <!-- Upward Android-Style Folder Flyout Box -->
    <Popup x:Name="GroupFlyoutPopup"
           IsOpen="{Binding FolderPopup.IsOpen, Mode=TwoWay}"
           Placement="Top"
           PlacementTarget="{Binding ElementName=MainTaskbarBorder}"
           VerticalOffset="-6"
           StaysOpen="False"
           AllowsTransparency="True">
      <views:FolderFlyoutControl DataContext="{Binding FolderPopup}" />
    </Popup>

    <!-- Full Taskbar Background Container -->
    <Border x:Name="MainTaskbarBorder"
            Background="{DynamicResource Theme.Brush.Surface}"
            BorderBrush="#2EFFFFFF"
            BorderThickness="1"
            CornerRadius="10"
            Padding="8,4"
            Margin="2"
            MouseLeftButtonDown="OnTaskbarBorderMouseLeftButtonDown">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ISLAND 1: Start Menu & Studio Island -->
        <Border Grid.Column="0"
                Background="#28000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="{Binding GroupPillCornerRadius}"
                Padding="6,3"
                Margin="0,0,8,0"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button Command="{Binding OpenStartMenuCommand}"
                    Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"
                    Margin="0,0,4,0"
                    Padding="9,4"
                    ToolTip="Windows 11 Başlat Menüsünü Aç">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="⊞ " Foreground="{DynamicResource Token.Brush.Accent}" FontWeight="Bold" FontSize="13" />
                <TextBlock Text="{DynamicResource Loc.Taskbar.Start}" FontWeight="Bold" FontSize="12" />
              </StackPanel>
            </Button>

            <Button Click="OnOpenSettingsClick"
                    Background="{DynamicResource Token.Brush.Accent}"
                    Foreground="White"
                    FontWeight="Bold"
                    Padding="9,4"
                    FontSize="12"
                    ToolTip="{DynamicResource Loc.Settings.Title}">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="🎨 " FontSize="12" />
                <TextBlock Text="{DynamicResource Loc.Taskbar.Studio}" FontWeight="Bold" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Border>

        <!-- ISLAND 2: Unified Dock (Android Mini Folder Boxes + Unified Pinned & Running Windows Icons) -->
        <Border Grid.Column="1"
                Background="#28000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="{Binding GroupPillCornerRadius}"
                Padding="10,3"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Visibility="{Binding ShowOpenWindows, Converter={StaticResource BoolToVis}}">
          <ScrollViewer x:Name="WindowsScrollViewer"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="OnWindowsScrollViewerPreviewMouseWheel">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

              <!-- 1. Android-Style Mini Folder Boxes (2x2 Mini Icon Grid inside each box!) -->
              <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="{Binding DataContext.IconShapeCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=52}"
                            BorderBrush="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=140}"
                            BorderThickness="1.5"
                            Margin="3,0">
                      <Button Click="OnGroupPillButtonClick"
                              Tag="{Binding}"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnGroupPillPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnGroupPillPreviewMouseMove"
                              DragOver="OnGroupPillDragOver"
                              Drop="OnGroupPillDrop"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="6,4"
                              ToolTip="Tıklayın: Klasör kutusu açılsın | Üstüne uygulama sürükleyip bırakın!">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                          <!-- Android 2x2 Mini Icon Grid Box -->
                          <Border Width="26"
                                  Height="26"
                                  CornerRadius="6"
                                  Background="#38000000"
                                  Padding="2">
                            <ItemsControl ItemsSource="{Binding PreviewApplications}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                  <UniformGrid Rows="2" Columns="2" />
                                </ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                  <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                                         Width="10"
                                         Height="10"
                                         Margin="0.5"
                                         RenderOptions.BitmapScalingMode="HighQuality" />
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </Border>

                          <TextBlock Text="{Binding Name}"
                                     Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                     FontWeight="Bold"
                                     FontSize="11.5"
                                     Margin="6,0,0,0"
                                     VerticalAlignment="Center" />

                          <!-- Green / Accent Running Dot when an app inside this Folder Box is open! -->
                          <Border Width="7"
                                  Height="7"
                                  CornerRadius="3.5"
                                  Background="{DynamicResource Token.Brush.Accent}"
                                  Margin="6,0,2,0"
                                  VerticalAlignment="Center"
                                  Visibility="{Binding HasRunningApplications, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 2. Unified Pinned & Active Windows Taskbar Icons (Drag 1 Icon Onto Another to Create an Android Folder Box!) -->
              <ItemsControl ItemsSource="{Binding UnifiedTaskbarItems}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border CornerRadius="{Binding DataContext.IconShapeCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}"
                            Margin="3,0"
                            BorderThickness="1">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="#18FFFFFF" />
                          <Setter Property="BorderBrush" Value="#24FFFFFF" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                              <Setter Property="Background" Value="#2EFFFFFF" />
                              <Setter Property="BorderBrush" Value="#48FFFFFF" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Background" Value="#42FFFFFF" />
                              <Setter Property="BorderBrush" Value="{DynamicResource Token.Brush.Accent}" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>

                      <Button Command="{Binding DataContext.ClickUnifiedTaskbarItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              AllowDrop="True"
                              PreviewMouseLeftButtonDown="OnUnifiedAppPreviewMouseLeftButtonDown"
                              PreviewMouseMove="OnUnifiedAppPreviewMouseMove"
                              DragOver="OnUnifiedAppDragOver"
                              Drop="OnUnifiedAppDrop"
                              Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="7,4"
                              ToolTip="{Binding TooltipText}">
                        <Button.ContextMenu>
                          <ContextMenu Background="{DynamicResource Theme.Brush.Surface}"
                                       BorderBrush="{DynamicResource Token.Brush.Accent}"
                                       BorderThickness="1.5"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                       Padding="4">
                            <MenuItem Header="{Binding DisplayName}"
                                      FontWeight="Bold"
                                      IsEnabled="False" />
                            <Separator />
                            <MenuItem Header="{DynamicResource Loc.Context.SwitchOrRestore}"
                                      Command="{Binding PlacementTarget.Tag.ClickUnifiedTaskbarItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{DynamicResource Loc.Context.NewWindow}"
                                      Command="{Binding PlacementTarget.Tag.LaunchNewInstanceOfUnifiedItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}" />
                            <MenuItem Header="{DynamicResource Loc.Context.MinimizeWindow}"
                                      Command="{Binding PlacementTarget.Tag.MinimizeUnifiedItemWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <Separator Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{DynamicResource Loc.Context.CloseWindow}"
                                      Command="{Binding PlacementTarget.Tag.CloseUnifiedItemWindowCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                            <MenuItem Header="{DynamicResource Loc.Context.EndTask}"
                                      Command="{Binding PlacementTarget.Tag.EndUnifiedItemTaskCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                      CommandParameter="{Binding}"
                                      Foreground="#F87171"
                                      FontWeight="Bold"
                                      Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                          </ContextMenu>
                        </Button.ContextMenu>
                        <Grid>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                  VerticalAlignment="Center">
                              <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                                     Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                     Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                     RenderOptions.BitmapScalingMode="HighQuality"
                                     Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}}" />
                              <TextBlock Text="🪟"
                                         FontSize="14"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}, ConverterParameter=Invert}" />
                            </Grid>

                            <!-- Show active window title softly next to unpinned running windows or focused window -->
                            <TextBlock Text="{Binding DisplayName}"
                                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                       FontWeight="SemiBold"
                                       FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="115"
                                       Margin="6,0,2,0"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                          </StackPanel>

                          <!-- Windows 11 Style Bottom Running / Active Pill Indicator -->
                          <Border Grid.Row="1"
                                  Height="3"
                                  CornerRadius="1.5"
                                  Margin="0,3,0,0"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                            <Border.Style>
                              <Style TargetType="Border">
                                <Setter Property="Width" Value="8" />
                                <Setter Property="Background" Value="#AAFFFFFF" />
                                <Style.Triggers>
                                  <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter Property="Width" Value="18" />
                                    <Setter Property="Background" Value="{DynamicResource Token.Brush.Accent}" />
                                  </DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </Border.Style>
                          </Border>
                        </Grid>
                      </Button>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>
        </Border>

        <!-- ISLAND 3: System Status Tray (Wi-Fi, Bluetooth, Battery First + Clock + Swap) -->
        <Border Grid.Column="2"
                Background="#28000000"
                BorderBrush="#22FFFFFF"
                BorderThickness="1"
                CornerRadius="{Binding GroupPillCornerRadius}"
                Padding="6,3"
                VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding ShowPowerBadge, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center">
              <!-- 1. Wi-Fi Indicator -->
              <Button Content="{Binding WifiStatusText}"
                      Command="{Binding OpenWifiSettingsCommand}"
                      Background="#22FFFFFF"
                      BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      Margin="0,0,4,0"
                      Padding="7,4"
                      FontSize="11.5"
                      FontWeight="SemiBold"
                      ToolTip="Wi-Fi &amp; Network" />

              <!-- 2. Bluetooth Indicator -->
              <Button Content="{Binding BluetoothStatusText}"
                      Command="{Binding OpenBluetoothSettingsCommand}"
                      Background="#22FFFFFF"
                      BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      Margin="0,0,4,0"
                      Padding="7,4"
                      FontSize="11.5"
                      FontWeight="SemiBold"
                      ToolTip="Bluetooth" />

              <!-- 3. Battery (Pil) Indicator -->
              <Button Content="{Binding BatteryStatusText}"
                      Command="{Binding CyclePowerModeCommand}"
                      Background="#22FFFFFF"
                      BorderBrush="#30FFFFFF"
                      BorderThickness="1"
                      Margin="0,0,6,0"
                      Padding="8,4"
                      FontSize="11.5"
                      FontWeight="Bold"
                      ToolTip="Battery / Power Mode" />
            </StackPanel>

            <!-- 4. Live Clock & Date -->
            <StackPanel Visibility="{Binding ShowClock, Converter={StaticResource BoolToVis}}"
                        VerticalAlignment="Center"
                        Margin="2,0,8,0">
              <TextBlock Text="{Binding CurrentTimeText}"
                         Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                         FontSize="11.5"
                         FontWeight="Bold"
                         HorizontalAlignment="Right" />
              <TextBlock Text="{Binding CurrentDateText}"
                         Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                         FontSize="9.5"
                         HorizontalAlignment="Right" />
            </StackPanel>

            <!-- 5. 1-Click Return to Microsoft Taskbar -->
            <Button Content="{DynamicResource Loc.Taskbar.ReturnMicrosoft}"
                    Command="{Binding SwitchBackToMicrosoftTaskbarCommand}"
                    Padding="8,4"
                    FontSize="11"
                    FontWeight="SemiBold" />
          </StackPanel>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
