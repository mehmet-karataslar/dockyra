<Window x:Class="Dockyra.Presentation.Wpf.Views.TaskbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Dockyra.Presentation.Wpf.Views"
        Title="{DynamicResource Loc.App.Title}"
        Height="60"
        Width="1180"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">
  <Grid>
    <Popup IsOpen="{Binding FolderPopup.IsOpen, Mode=TwoWay}"
           Placement="Top"
           PlacementTarget="{Binding ElementName=MainTaskbarBorder}"
           StaysOpen="False"
           AllowsTransparency="True">
      <views:FolderFlyoutControl DataContext="{Binding FolderPopup}" />
    </Popup>

    <Border x:Name="MainTaskbarBorder"
            Background="{DynamicResource Theme.Brush.Surface}"
            BorderBrush="{DynamicResource Theme.Brush.Border}"
            BorderThickness="1"
            CornerRadius="{DynamicResource Token.Radius.LG}"
            Padding="{DynamicResource Token.Spacing.BarPadding}"
            Margin="8,4,8,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Section 1: Application Groups & Folders -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.OpenGroupFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="0,0,6,0"
                        Padding="10,5">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁 " />
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <TextBlock Text=" ▼" FontSize="10" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- Section 2: Open Running Windows -->
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Disabled"
                      Margin="12,0">
          <ItemsControl ItemsSource="{Binding OpenWindows}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Command="{Binding DataContext.ActivateOrToggleWindowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}"
                        Margin="3,0"
                        Padding="10,5"
                        MaxWidth="200"
                        ToolTip="{Binding Title}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="● " Foreground="{DynamicResource Token.Brush.Accent}" />
                    <TextBlock Text="{Binding ProcessName}" FontWeight="Medium" Margin="0,0,4,0" />
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- Section 3: Profile, Power Mode & Settings -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding ActiveProfile.Name, FallbackValue=Profil}"
                  Margin="0,0,6,0"
                  Padding="8,5"
                  Click="OnCycleProfileClick"
                  ToolTip="Çalışma Profilini Değiştir" />
          <Button Content="{Binding CurrentPowerMode}"
                  Command="{Binding CyclePowerModeCommand}"
                  Margin="0,0,6,0"
                  Padding="8,5"
                  ToolTip="{DynamicResource Loc.Action.CyclePowerMode}" />
          <Button Content="⟳"
                  Command="{Binding RefreshWindowsCommand}"
                  Margin="0,0,6,0"
                  Padding="8,5"
                  ToolTip="{DynamicResource Loc.Action.RefreshWindows}" />
          <Button Content="⚙"
                  Click="OnOpenSettingsClick"
                  Padding="8,5"
                  ToolTip="{DynamicResource Loc.Action.OpenSettings}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>

