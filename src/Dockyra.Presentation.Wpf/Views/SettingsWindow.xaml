<Window x:Class="Dockyra.Presentation.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Dockyra.Presentation.Wpf.Converters"
        Title="{DynamicResource Loc.Settings.Title}"
        Width="1080"
        Height="750"
        MinWidth="940"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Brush.Surface}">
  <Window.Resources>
    <conv:Bgra32ToImageSourceConverter x:Key="IconConverter" />
    <conv:BytesPresenceToVisibilityConverter x:Key="BytesVisConverter" />
    <conv:HexToBrushConverter x:Key="HexBrush" />
  </Window.Resources>

  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Row 0: Systematic Studio Header + Language Switcher (TR/EN) + Active Taskbar Status -->
    <Border Grid.Row="0"
            Background="{DynamicResource Theme.Brush.Card}"
            BorderBrush="{DynamicResource Theme.Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16,12"
            Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <Border Background="{DynamicResource Token.Brush.Accent}"
                    CornerRadius="6"
                    Padding="8,3"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Loc.Studio.Badge}"
                         Foreground="White"
                         FontWeight="Bold"
                         FontSize="11.5" />
            </Border>
            <TextBlock Text="{DynamicResource Loc.Settings.Title}"
                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                       FontSize="17.5"
                       FontWeight="Bold"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{DynamicResource Loc.Studio.Subtitle}"
                     Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                     FontSize="12"
                     Margin="0,4,0,0" />
        </StackPanel>

        <!-- Language Switcher + Active State Badge -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Background="{DynamicResource Theme.Brush.Surface}"
                  BorderBrush="{DynamicResource Theme.Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="8,5"
                  Margin="0,0,10,0"
                  VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="{DynamicResource Loc.Studio.LanguageLabel}"
                         Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                         FontSize="11.5"
                         VerticalAlignment="Center"
                         Margin="0,0,6,0" />
              <Button Content="🇹🇷 Türkçe"
                      Command="{Binding SetLanguageCommand}"
                      CommandParameter="tr-TR"
                      Padding="8,3"
                      Margin="0,0,4,0"
                      FontSize="11.5"
                      FontWeight="SemiBold" />
              <Button Content="🇬🇧 English"
                      Command="{Binding SetLanguageCommand}"
                      CommandParameter="en-US"
                      Padding="8,3"
                      FontSize="11.5"
                      FontWeight="SemiBold" />
            </StackPanel>
          </Border>

          <Border Background="{DynamicResource Theme.Brush.Surface}"
                  BorderBrush="{DynamicResource Theme.Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="12,8"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding ActiveTaskbarStateText}"
                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                       FontWeight="SemiBold"
                       FontSize="12" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Row 1: Systematic 5-Tab Personalization Workspace -->
    <TabControl Grid.Row="1"
                Background="{DynamicResource Theme.Brush.Card}"
                BorderBrush="{DynamicResource Theme.Brush.Border}">

      <!-- TAB 1: COLOR PALETTE & THEME STUDIO (Visual Swatches Only, No Hex Codes!) -->
      <TabItem Header="{DynamicResource Loc.Tab.Colors}" Padding="12,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
          <StackPanel>
            <TextBlock Text="{DynamicResource Loc.Colors.PresetsTitle}"
                       Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                       FontSize="15"
                       FontWeight="Bold"
                       Margin="0,0,0,10" />

            <ItemsControl ItemsSource="{Binding ColorPresets}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Command="{Binding DataContext.SelectColorPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                          CommandParameter="{Binding}"
                          Width="232"
                          Margin="0,0,10,10"
                          Padding="10"
                          HorizontalContentAlignment="Stretch">
                    <StackPanel>
                      <Border CornerRadius="6"
                              Height="26"
                              Margin="0,0,0,8"
                              BorderBrush="#33FFFFFF"
                              BorderThickness="1"
                              ClipToBounds="True">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1*" />
                          </Grid.ColumnDefinitions>
                          <Border Grid.Column="0" Background="{Binding SurfaceHex, Converter={StaticResource HexBrush}}" />
                          <Border Grid.Column="1" Background="{Binding AccentHex, Converter={StaticResource HexBrush}}" />
                        </Grid>
                      </Border>

                      <TextBlock Text="{Binding Name}"
                                 FontWeight="Bold"
                                 FontSize="12.5"
                                 Margin="0,0,0,2" />
                      <TextBlock Text="{Binding Description}"
                                 FontSize="11"
                                 Opacity="0.8"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Visual Color Swatch Pickers -->
            <Grid Margin="0,6,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <Border Grid.Column="0"
                      Background="{DynamicResource Theme.Brush.Surface}"
                      CornerRadius="8"
                      Padding="12"
                      Margin="0,0,6,0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Loc.Colors.SurfaceTitle}"
                             Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                             FontWeight="Bold"
                             FontSize="13.5"
                             Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding SurfaceSwatches}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding DataContext.SelectSurfaceSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,6,6"
                                Padding="8,6">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <Border Grid.Column="1"
                      Background="{DynamicResource Theme.Brush.Surface}"
                      CornerRadius="8"
                      Padding="12"
                      Margin="6,0,0,0">
                <StackPanel>
                  <TextBlock Text="{DynamicResource Loc.Colors.AccentTitle}"
                             Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                             FontWeight="Bold"
                             FontSize="13.5"
                             Margin="0,0,0,8" />
                  <ItemsControl ItemsSource="{Binding AccentSwatches}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding DataContext.SelectAccentSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Margin="0,0,6,6"
                                Padding="8,6">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="20"
                                    Height="20"
                                    CornerRadius="5"
                                    Background="{Binding ColorHex, Converter={StaticResource HexBrush}}"
                                    BorderBrush="#55FFFFFF"
                                    BorderThickness="1"
                                    Margin="0,0,6,0" />
                            <TextBlock Text="{Binding Label}" FontSize="11.5" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TAB 2: LIVE TASKBAR HEIGHT, WIDTH, ICON SIZE & ICON SHAPE (Circle / Square) -->
      <TabItem Header="{DynamicResource Loc.Tab.Layout}" Padding="12,6">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Column: Live Sliders (Height, Width %, Icon Size, Corner Radius, Opacity) -->
            <Border Grid.Column="0"
                    Background="{DynamicResource Theme.Brush.Surface}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,8,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Layout.DimensionsTitle}"
                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,14" />

                <DockPanel Margin="0,2">
                  <TextBlock Text="{DynamicResource Loc.Layout.BarHeight}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding BarHeight, StringFormat='{}{0} px'}" Foreground="{DynamicResource Token.Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="40" Maximum="72" Value="{Binding BarHeight, UpdateSourceTrigger=PropertyChanged}" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,4,0,12" />

                <DockPanel Margin="0,2">
                  <TextBlock Text="{DynamicResource Loc.Layout.BarWidth}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding BarWidthPercent, StringFormat='%{0}'}" Foreground="{DynamicResource Token.Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="50" Maximum="100" Value="{Binding BarWidthPercent, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,12" />

                <DockPanel Margin="0,2">
                  <TextBlock Text="{DynamicResource Loc.Layout.IconSize}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding IconSize, StringFormat='{}{0} px'}" Foreground="{DynamicResource Token.Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="18" Maximum="38" Value="{Binding IconSize, UpdateSourceTrigger=PropertyChanged}" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,4,0,12" />

                <DockPanel Margin="0,2">
                  <TextBlock Text="{DynamicResource Loc.Layout.CornerRadius}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding CornerRadius, StringFormat='{}{0} px'}" Foreground="{DynamicResource Token.Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="0" Maximum="22" Value="{Binding CornerRadius, UpdateSourceTrigger=PropertyChanged}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,12" />

                <DockPanel Margin="0,2">
                  <TextBlock Text="{DynamicResource Loc.Layout.Opacity}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding OpacityPercent, StringFormat='%{0}'}" Foreground="{DynamicResource Token.Brush.Accent}" FontWeight="Bold" HorizontalAlignment="Right" />
                </DockPanel>
                <Slider Minimum="55" Maximum="100" Value="{Binding OpacityPercent, UpdateSourceTrigger=PropertyChanged}" TickFrequency="5" IsSnapToTickEnabled="True" Margin="0,4,0,4" />
              </StackPanel>
            </Border>

            <!-- Right Column: Icon Shape Selector (Circle / Rounded Square / Square / Capsule) & Position -->
            <Border Grid.Column="1"
                    Background="{DynamicResource Theme.Brush.Surface}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="8,0,0,0">
              <StackPanel>
                <TextBlock Text="{DynamicResource Loc.Layout.IconShapeTitle}"
                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           FontSize="15"
                           FontWeight="Bold"
                           Margin="0,0,0,10" />

                <!-- 4 Visual Shape Cards -->
                <WrapPanel Orientation="Horizontal" Margin="0,0,0,14">
                  <Button Command="{Binding SetIconShapeCommand}"
                          CommandParameter="Circle"
                          Width="195"
                          Margin="0,0,8,8"
                          Padding="10,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="24" Height="24" CornerRadius="12" Background="{DynamicResource Token.Brush.Accent}" Margin="0,0,8,0" />
                      <TextBlock Text="{DynamicResource Loc.Layout.ShapeCircle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Command="{Binding SetIconShapeCommand}"
                          CommandParameter="RoundedSquare"
                          Width="195"
                          Margin="0,0,8,8"
                          Padding="10,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource Token.Brush.Accent}" Margin="0,0,8,0" />
                      <TextBlock Text="{DynamicResource Loc.Layout.ShapeRoundedSquare}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Command="{Binding SetIconShapeCommand}"
                          CommandParameter="Square"
                          Width="195"
                          Margin="0,0,8,8"
                          Padding="10,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="24" Height="24" CornerRadius="1" Background="{DynamicResource Token.Brush.Accent}" Margin="0,0,8,0" />
                      <TextBlock Text="{DynamicResource Loc.Layout.ShapeSquare}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Button Command="{Binding SetIconShapeCommand}"
                          CommandParameter="Capsule"
                          Width="195"
                          Margin="0,0,8,8"
                          Padding="10,8">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="30" Height="20" CornerRadius="10" Background="{DynamicResource Token.Brush.Accent}" Margin="0,0,8,0" />
                      <TextBlock Text="{DynamicResource Loc.Layout.ShapeCapsule}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </WrapPanel>

                <TextBlock Text="{DynamicResource Loc.Layout.PositionTitle}"
                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           FontSize="14.5"
                           FontWeight="Bold"
                           Margin="0,0,0,8" />

                <Grid Margin="0,0,0,10">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" Margin="0,0,6,0">
                    <TextBlock Text="{DynamicResource Loc.Layout.DockEdge}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding DockEdgeOptions}" SelectedItem="{Binding SelectedDockEdge}" Padding="8,5" />
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="6,0,0,0">
                    <TextBlock Text="{DynamicResource Loc.Layout.Alignment}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding AlignmentOptions}" SelectedItem="{Binding SelectedAlignment}" Padding="8,5" />
                  </StackPanel>
                </Grid>

                <CheckBox Content="{DynamicResource Loc.Layout.ShowStart}"
                          IsChecked="{Binding ShowStartButton}"
                          Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                          Margin="0,4" />
                <CheckBox Content="{DynamicResource Loc.Layout.ShowWindows}"
                          IsChecked="{Binding ShowOpenWindows}"
                          Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                          Margin="0,4" />
                <CheckBox Content="{DynamicResource Loc.Layout.ShowClock}"
                          IsChecked="{Binding ShowClock}"
                          Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                          Margin="0,4" />
                <CheckBox Content="{DynamicResource Loc.Layout.ShowPower}"
                          IsChecked="{Binding ShowPowerBadge}"
                          Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                          Margin="0,4" />
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- TAB 3: GROUPS, FOLDERS & DRAG-AND-DROP ORGANIZER -->
      <TabItem Header="{DynamicResource Loc.Tab.Folders}" Padding="12,6">
        <Grid Margin="10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="300" />
          </Grid.ColumnDefinitions>

          <!-- Column 0: Groups / Folders List -->
          <Border Grid.Column="0"
                  Background="{DynamicResource Theme.Brush.Surface}"
                  CornerRadius="8"
                  Padding="10"
                  Margin="0,0,6,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Loc.Folders.Col1Title}"
                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           FontWeight="Bold"
                           FontSize="13.5" />
                <TextBlock Text="{DynamicResource Loc.Folders.Col1Sub}"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="11" />
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding AccentSwatches}" Margin="0,0,0,6">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Command="{Binding DataContext.SelectFolderColorSwatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Padding="2"
                              Margin="0,0,4,4"
                              ToolTip="{Binding Label}">
                        <Border Width="16"
                                Height="16"
                                CornerRadius="8"
                                Background="{Binding ColorHex, Converter={StaticResource HexBrush}}" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                  <Button Content="▲" Command="{Binding MoveSelectedGroupUpCommand}" Padding="10,4" Margin="0,0,4,0" />
                  <Button Content="▼" Command="{Binding MoveSelectedGroupDownCommand}" Padding="10,4" Margin="0,0,4,0" />
                  <Button Content="🗑 Sil" Command="{Binding DeleteSelectedGroupCommand}" Padding="10,4" />
                </StackPanel>

                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>
                  <TextBox Grid.Column="0"
                           Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}"
                           Padding="6,4"
                           Margin="0,0,4,0" />
                  <Button Grid.Column="1"
                          Content="+ Ekle"
                          Command="{Binding CreateNewGroupCommand}"
                          Padding="10,4"
                          FontWeight="Bold" />
                </Grid>
              </StackPanel>

              <ListBox x:Name="GroupsListBox"
                       ItemsSource="{Binding EditableGroups}"
                       SelectedItem="{Binding SelectedGroup}"
                       AllowDrop="True"
                       PreviewMouseLeftButtonDown="OnGroupsListPreviewMouseLeftButtonDown"
                       PreviewMouseMove="OnGroupsListPreviewMouseMove"
                       Drop="OnGroupsListDrop"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,6"
                            Margin="0,3"
                            CornerRadius="7"
                            Background="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=42}"
                            BorderBrush="{Binding ColorHex, Converter={StaticResource HexBrush}, ConverterParameter=110}"
                            BorderThickness="1">
                      <DockPanel>
                        <TextBlock Text="☰ 📂 " FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Theme.Brush.TextPrimary}" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Applications.Count, StringFormat=' ({0})'}"
                                   Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Center" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <!-- Column 1: Selected Group Applications -->
          <Border Grid.Column="1"
                  Background="{DynamicResource Theme.Brush.Surface}"
                  BorderBrush="{DynamicResource Theme.Brush.Border}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="10"
                  Margin="6,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Loc.Folders.Col2Title}"
                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           FontWeight="Bold"
                           FontSize="13.5" />
                <TextBlock Text="{DynamicResource Loc.Folders.Col2Sub}"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="11" />
              </StackPanel>

              <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <Button Content="{DynamicResource Loc.Folders.BrowseBtn}"
                        Click="OnBrowseExecutableClick"
                        Padding="10,6"
                        FontWeight="SemiBold" />
              </StackPanel>

              <ListBox x:Name="GroupAppsListBox"
                       ItemsSource="{Binding SelectedGroupApps}"
                       AllowDrop="True"
                       PreviewMouseLeftButtonDown="OnGroupAppsPreviewMouseLeftButtonDown"
                       PreviewMouseMove="OnGroupAppsPreviewMouseMove"
                       DragOver="OnGroupAppsDragOver"
                       Drop="OnGroupAppsDrop"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{DynamicResource Theme.Brush.Card}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="✕"
                                Command="{Binding DataContext.RemoveAppFromSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="6,2"
                                Margin="6,0,0,0" />
                        <TextBlock Text="☰ " Foreground="{DynamicResource Token.Brush.Accent}" VerticalAlignment="Center" />
                        <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                          <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                                 Width="22"
                                 Height="22"
                                 RenderOptions.BitmapScalingMode="HighQuality"
                                 Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}}" />
                          <TextBlock Text="🚀"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}, ConverterParameter=Invert}" />
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>

          <!-- Column 2: Native Windows 11 Pinned Shortcuts Pool -->
          <Border Grid.Column="2"
                  Background="{DynamicResource Theme.Brush.Surface}"
                  CornerRadius="8"
                  Padding="10"
                  Margin="6,0,0,0">
            <DockPanel>
              <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock Text="{DynamicResource Loc.Folders.Col3Title}"
                           Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                           FontWeight="Bold"
                           FontSize="13.5" />
                <TextBlock Text="{DynamicResource Loc.Folders.Col3Sub}"
                           Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                           FontSize="11" />
              </StackPanel>

              <ListBox x:Name="AvailableShortcutsListBox"
                       ItemsSource="{Binding AvailableShortcuts}"
                       PreviewMouseLeftButtonDown="OnShortcutsPreviewMouseLeftButtonDown"
                       PreviewMouseMove="OnShortcutsPreviewMouseMove"
                       Background="Transparent"
                       BorderThickness="0">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Border Padding="8,6" Margin="0,2" CornerRadius="6" Background="{DynamicResource Theme.Brush.Card}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="{DynamicResource Loc.Folders.AddBtn}"
                                Command="{Binding DataContext.AddShortcutToSelectedGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"
                                Padding="6,2"
                                Margin="6,0,0,0" />
                        <Grid Width="22" Height="22" Margin="0,0,8,0" VerticalAlignment="Center">
                          <Image Source="{Binding IconBgra32, Converter={StaticResource IconConverter}}"
                                 Width="22"
                                 Height="22"
                                 RenderOptions.BitmapScalingMode="HighQuality"
                                 Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}}" />
                          <TextBlock Text="📌"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding IconBgra32, Converter={StaticResource BytesVisConverter}, ConverterParameter=Invert}" />
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 4: PROFILES & POWER MANAGEMENT -->
      <TabItem Header="{DynamicResource Loc.Tab.Profiles}" Padding="12,6">
        <Grid Margin="14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Background="{DynamicResource Theme.Brush.Surface}" CornerRadius="8" Padding="14" Margin="0,0,8,0">
            <StackPanel>
              <TextBlock Text="Çalışma Profilleri / Work Profiles"
                         Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                         FontSize="15"
                         FontWeight="Bold"
                         Margin="0,0,0,10" />
              <ComboBox ItemsSource="{Binding EditableProfiles}"
                        SelectedItem="{Binding SelectedProfile}"
                        DisplayMemberPath="Name"
                        Padding="8,6"
                        Margin="0,0,0,10" />
              <TextBlock Text="{Binding SelectedProfile.Description}"
                         Foreground="{DynamicResource Theme.Brush.TextSecondary}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Background="{DynamicResource Theme.Brush.Surface}" CornerRadius="8" Padding="14" Margin="8,0,0,0">
            <StackPanel>
              <TextBlock Text="{DynamicResource Loc.Section.System}"
                         Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                         FontSize="15"
                         FontWeight="Bold"
                         Margin="0,0,0,10" />
              <ComboBox ItemsSource="{Binding PowerModeOptions}"
                        SelectedItem="{Binding SelectedPowerMode}"
                        Padding="8,6"
                        Margin="0,0,0,12" />
              <CheckBox Content="Pilde otomatik Güç Tasarrufu (PowerSaver) / Auto Battery Saver"
                        IsChecked="{Binding AutoPowerSaveOnBattery}"
                        Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                        Margin="0,4" />
              <CheckBox Content="Akıcı animasyonlar / Smooth Animations"
                        IsChecked="{Binding EnableAnimations}"
                        Foreground="{DynamicResource Theme.Brush.TextPrimary}"
                        Margin="0,4" />
            </StackPanel>
          </Border>
        </Grid>
      </TabItem>

      <!-- TAB 5: BACKUP, RESTORE & RESET -->
      <TabItem Header="{DynamicResource Loc.Tab.Backup}" Padding="12,6">
        <DockPanel Margin="14">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <Button Content="{DynamicResource Loc.Settings.ExportBackup}"
                    Command="{Binding ExportBackupJsonCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0" />
            <Button Content="📥 JSON Import / Geri Yükle"
                    Command="{Binding ImportBackupJsonCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0" />
            <Button Content="{DynamicResource Loc.Settings.ResetLayout}"
                    Command="{Binding ResetLayoutCommand}"
                    Padding="12,6" />
          </StackPanel>
          <TextBox Text="{Binding ExportedJsonPreview, UpdateSourceTrigger=PropertyChanged}"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap"
                   AcceptsReturn="True"
                   Padding="10" />
        </DockPanel>
      </TabItem>
    </TabControl>

    <!-- Row 2: PRIMARY TASKBAR SWITCHER ACTION BAR -->
    <Border Grid.Row="2"
            Background="{DynamicResource Theme.Brush.Card}"
            BorderBrush="{DynamicResource Theme.Brush.Border}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14,10"
            Margin="0,12,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="{Binding SwapButtonText}"
                  Command="{Binding SwapTaskbarSystemCommand}"
                  Background="{DynamicResource Token.Brush.Accent}"
                  Foreground="White"
                  FontWeight="Bold"
                  FontSize="13"
                  Padding="16,9"
                  Margin="0,0,10,0" />

          <Button Content="{DynamicResource Loc.Action.FullTaskbar}"
                  Command="{Binding ActivateDockyraFullTaskbarCommand}"
                  FontWeight="SemiBold"
                  Padding="12,9"
                  Margin="0,0,8,0" />

          <Button Content="{DynamicResource Loc.Action.OverlayTaskbar}"
                  Command="{Binding ActivateDockyraOverlayTaskbarCommand}"
                  Padding="12,9"
                  Margin="0,0,8,0" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button Content="{DynamicResource Loc.Action.RestoreMicrosoft}"
                  Command="{Binding RestoreMicrosoftTaskbarCommand}"
                  Padding="12,9" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Row 3: Status Footer -->
    <TextBlock Grid.Row="3"
               Text="{Binding StatusMessage}"
               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
               FontSize="12"
               Margin="4,8,0,0" />
  </Grid>
</Window>
