<Window x:Class="Dockyra.Presentation.Wpf.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.Settings.Title}"
        Width="680"
        Height="520"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Theme.Brush.Surface}">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <TextBlock Text="{DynamicResource Loc.Settings.Title}"
               Foreground="{DynamicResource Theme.Brush.TextPrimary}"
               FontSize="{DynamicResource Token.FontSize.Title}"
               FontWeight="Bold"
               Margin="0,0,0,12" />

    <TabControl Grid.Row="1">
      <TabItem Header="1. Genel &amp; Görev Çubuğu">
        <StackPanel Margin="12">
          <CheckBox Content="Pilde otomatik güç tasarrufu moduna geç"
                    IsChecked="{Binding AutoPowerSaveOnBattery}"
                    Margin="0,6" />
          <StackPanel Orientation="Horizontal" Margin="0,8">
            <Button Content="Kaydet ve Uygula"
                    Command="{Binding SaveAndApplyCommand}"
                    Padding="12,6"
                    Margin="0,0,8,0" />
            <Button Content="{DynamicResource Loc.Settings.ResetLayout}"
                    Command="{Binding ResetLayoutCommand}"
                    Padding="12,6" />
          </StackPanel>
        </StackPanel>
      </TabItem>

      <TabItem Header="2. Yedekleme &amp; JSON">
        <DockPanel Margin="12">
          <Button DockPanel.Dock="Top"
                  Content="{DynamicResource Loc.Settings.ExportBackup}"
                  Command="{Binding ExportBackupJsonCommand}"
                  HorizontalAlignment="Left"
                  Padding="12,6"
                  Margin="0,0,0,8" />
          <TextBox Text="{Binding ExportedJsonPreview, Mode=OneWay}"
                   IsReadOnly="True"
                   VerticalScrollBarVisibility="Auto"
                   TextWrapping="Wrap" />
        </DockPanel>
      </TabItem>
    </TabControl>

    <TextBlock Grid.Row="2"
               Text="{Binding StatusMessage}"
               Foreground="{DynamicResource Theme.Brush.TextSecondary}"
               Margin="0,10,0,0" />
  </Grid>
</Window>

